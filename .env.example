# 你的 Key（用其他服务商时也填在这里）
ANTHROPIC_API_KEY=

# 模型名
MODEL=claude-opus-5-5

# 不用 Claude 时，去掉下一行开头的 # ，填上服务商的地址
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 搜索服务的密钥，填一家就行。都不填时：用 Claude 官方接口会让 Claude 那边的服务器去搜；别的模型就搜不了
# Tavily：https://tavily.com    博查：https://open.bochaai.com
TAVILY_API_KEY=
BOCHA_API_KEY=
# 两家都填了时用哪家（tavily 或 bocha）。不填就用上面第一个填了的
# SEARCH_PROVIDER=
# 搜索和读网页走哪条路：auto（默认）、own（只用自己写的工具）、server（只让模型那边的服务器做）
# WEB_MODE=auto

# 每天最多用多少 token（发的加上回的）。到了就不再调模型，告诉你一声，第二天自动恢复。不填是 200 万，填 0 表示不限
# DAILY_TOKEN_LIMIT=2000000

# 飞书群自定义机器人的 Webhook 地址，用来发通知。不填就不发
FEISHU_WEBHOOK=

# 飞书应用机器人的凭证（开发者后台 → 凭证与基础信息），用来在飞书里和它对话。不填就用不了
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 你自己在这个应用里的编号（ou_ 开头）。飞书入口只听这个人的消息，不填就不启动
# 先运行 python -m playground.feishu_echo，在飞书里发一句话，终端里"谁发的"后面就是它
FEISHU_OWNER_ID=